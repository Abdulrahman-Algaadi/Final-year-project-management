NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Direct Postgres URL (port 5432) for migrations and seed — NOT the pooler URL
MIGRATE_DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# PostgreSQL — Supabase Shared Pooler (recommended for server apps)
# Dashboard → Project Settings → Database → Connection string → Shared Pooler
DATABASE_URL=postgresql://postgres.gdjbxalthbugzayviqka:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Or use individual fields (used when DATABASE_URL is not set)
DATABASE_HOST=aws-1-eu-central-1.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_USER=postgres.gdjbxalthbugzayviqka
DATABASE_PASSWORD=your-database-password
DATABASE_NAME=postgres
DATABASE_SSL=true
DATABASE_POOLER=true

# Supabase project: gdjbxalthbugzayviqka
SUPABASE_URL=https://gdjbxalthbugzayviqka.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional — set for fast local JWT verification (Dashboard → Project Settings → API → JWT Secret)
# Without this, every API call validates the token against Supabase over the network.
SUPABASE_JWT_SECRET=

# Storage
SUPABASE_STORAGE_BUCKET=submissions

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS — comma-separated origins (production Vercel URL + local dev)
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,https://your-app.vercel.app
# Allow *.vercel.app preview deployments (set to false to disable)
CORS_ALLOW_VERCEL=true
