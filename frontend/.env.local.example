# ── Local development ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ── Vercel production (set in Vercel dashboard, not in this file) ─────────────
# Option A — baked into client at build time:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_API_URL=https://your-api.onrender.com/api/v1
#
# Option B — read at runtime via /api/public-config (also works if only set on server):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# API_URL=https://your-api.onrender.com/api/v1
#
# Enable Production + Preview + Development for all variables, then redeploy.
